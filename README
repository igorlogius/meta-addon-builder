#!/usr/bin/env bash
#
# Build a WebExtension from its GitHub sources, bump the patch version,
# and upload it to AMO 
#
# https://addons-server.readthedocs.io/en/latest/topics/api/v4_frozen/signing.html#v4-upload-version
#
# Required env: GITHUB_REPOSITORY_OWNER, GITHUB_WORKFLOW (extension folder / AMO slug),
#               ISSUER, SECRET (AMO API credentials)

set -euo pipefail

#
# constants
#

readonly BASE_URL="https://addons.mozilla.org"
readonly AMO_API_V4="$BASE_URL/api/v4/addons"
readonly MODULE_LINK_PREFIX="../../modules/"           # symlinks arrive as plain text files

TMP_ROOT=""   # single temp dir; removing it cleans up everything

#
# helpers
#

log() { printf '%s\n' "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

cleanup() {
    if [[ -n $TMP_ROOT ]]; then
        rm -rf -- "$TMP_ROOT"
    fi
}
trap cleanup EXIT

require_cmds() {
    local cmd missing=()
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done
    (( ${#missing[@]} == 0 )) || die "missing dependencies: ${missing[*]}"
}

require_vars() {
    local var missing=()
    for var in "$@"; do
        [[ -n ${!var:-} ]] || missing+=("$var")
    done
    (( ${#missing[@]} == 0 )) || die "missing variables: ${missing[*]}"
}

# request EXPECTED_STATUS URL [curl args...]
# Prints the response body on success; dies (showing the body) on any other status.
# -g/--globoff: GUIDs contain curly braces which curl would otherwise try to expand.
request() {
    local expected="$1" url="$2"
    shift 2

    local body status
    body=$(mktemp -p "$TMP_ROOT")
    status=$(curl -sSL -g --url "$url" -o "$body" -w '%{http_code}' "$@") \
        || die "request to $url failed"

    if [[ $status != "$expected" ]]; then
        cat "$body" >&2
        printf '\n' >&2
        die "$url returned HTTP $status (expected $expected)"
    fi
    cat "$body"
}

#
# versioning
#

# 1.2.3 -> 1.2.4
next_version() {
    local major minor patch
    IFS=. read -r major minor patch _ <<<"$1"
    patch=${patch:-0}
    [[ $major =~ ^[0-9]+$ && $minor =~ ^[0-9]+$ && $patch =~ ^[0-9]+$ ]] \
        || die "unsupported version format: '$1'"
    printf '%s.%s.%s\n' "$major" "$minor" "$((10#$patch + 1))"
}

set_manifest_version() {
    local version="$1" tmp
    [[ -f manifest.json ]] || die "manifest.json not found"
    tmp=$(mktemp -p "$TMP_ROOT")
    jq --arg version "$version" '.version = $version' manifest.json > "$tmp"
    cat "$tmp" > manifest.json   # cat (not mv) keeps the original file mode
}

#
# AMO auth
#

# base64url without padding
b64url() { base64 | tr -d '=\n' | tr '+/' '-_'; }

generate_jwt() {
    local iat header payload signature
    iat=$(date +%s)
    header=$(printf '%s' '{"alg":"HS256","typ":"JWT"}' | b64url)
    payload=$(printf '{"iss":"%s","iat":%d,"jti":"%s","exp":%d}' \
        "$ISSUER" "$iat" "$(openssl rand -hex 16)" "$((iat + 30))" | b64url)
    signature=$(printf '%s.%s' "$header" "$payload" \
        | openssl dgst -binary -sha256 -hmac "$SECRET" | b64url)
    printf '%s.%s.%s' "$header" "$payload" "$signature"
}

#
# build
#

# Bulk-download all top-level files of the extension folder via curl's config-file mode.
download_sources() {
    local listing
    listing=$(request 200 "https://api.github.com/repos/$GITHUB_REPOSITORY_OWNER/webextensions/contents/sources/$EXT_NAME")

    # capture first: a failure inside <(...) would not stop the script
    local curl_config
    curl_config=$(jq -r '.[] | select(.type == "file") | "url = \"\(.download_url)\"\noutput = \"\(.name)\""' <<<"$listing")
    curl -sSL --fail -K <(printf '%s\n' "$curl_config")
}

# Files that merely contain "../../modules/..." are symlinks; fetch the real content.
resolve_module_links() {
    local file
    for file in *; do
        [[ -f $file ]] || continue
        if [[ $(head -c "${#MODULE_LINK_PREFIX}" -- "$file" | tr -d '\0') == "$MODULE_LINK_PREFIX" ]]; then
            request 200 "https://raw.githubusercontent.com/$GITHUB_REPOSITORY_OWNER/webextensions/main/modules/$file" > "$file.new"
            mv "$file.new" "$file"
        fi
    done
}

#
# AMO actions
#

upload_xpi() {
    local guid="$1" version="$2" xpi="$3"
    request 202 "$AMO_API_V4/$guid/versions/$version/" \
        -X PUT \
        --form "upload=@$xpi" \
        -H "Authorization: JWT $(generate_jwt)" >/dev/null
}

#
# main
#

main() {
    # fail early, before doing any work
    require_vars GITHUB_REPOSITORY_OWNER GITHUB_WORKFLOW ISSUER SECRET
    require_cmds curl jq zip openssl base64 date head tr mktemp cat

    readonly EXT_NAME="$GITHUB_WORKFLOW"
    TMP_ROOT=$(mktemp -d)

    log "Looking up current AMO version of $EXT_NAME"
    local info amo_version amo_guid next_amo_version
    info=$(request 200 "$AMO_API_V4/addon/$EXT_NAME")
    amo_version=$(jq -er '.current_version.version' <<<"$info")
    amo_guid=$(jq -er '.guid' <<<"$info")
    next_amo_version=$(next_version "$amo_version")
    log "  $amo_version -> $next_amo_version ($amo_guid)"

    mkdir "$TMP_ROOT/src"
    cd "$TMP_ROOT/src"

    log "Downloading sources"
    download_sources
    resolve_module_links
    set_manifest_version "$next_amo_version"

    local xpi
    xpi="$TMP_ROOT/$EXT_NAME-$next_amo_version-$(date '+%F_%H-%M').zip"
    log "Packing $(basename "$xpi")"
    zip -qr "$xpi" ./*

    log "Uploading to AMO"
    upload_xpi "$amo_guid" "$next_amo_version" "$xpi"

    log "Done"
}

main "$@"
